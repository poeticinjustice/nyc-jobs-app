{
  "name": "nyc-jobs-app",
  "version": "1.0.0",
  "description": "MERN stack application for NYC job listings with user authentication and notes",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "install-client": "cd client && npm install",
    "install-server": "npm install",
    "install-all": "npm run install-server && npm run install-client",
    "test:server": "TZ=America/New_York jest --config jest.config.js",
    "test:server:watch": "TZ=America/New_York jest --config jest.config.js --watch",
    "test:server:coverage": "TZ=America/New_York jest --config jest.config.js --coverage",
    "test:helpers": "TZ=America/New_York jest --config jest.config.js --testPathPatterns=helpers",
    "test:auth": "TZ=America/New_York jest --config jest.config.js --testPathPatterns=auth",
    "test:jobs": "TZ=America/New_York jest --config jest.config.js --testPathPatterns=jobs",
    "test:notes": "TZ=America/New_York jest --config jest.config.js --testPathPatterns=notes",
    "test:searches": "TZ=America/New_York jest --config jest.config.js --testPathPatterns=searches",
    "test:dashboard": "TZ=America/New_York jest --config jest.config.js --testPathPatterns=dashboard",
    "test:middleware": "TZ=America/New_York jest --config jest.config.js --testPathPatterns=middleware",
    "refresh-jobs": "node server/scripts/refreshJobs.js",
    "send-alerts": "node server/scripts/sendAlerts.js"
  },
  "keywords": [
    "mern",
    "react",
    "node",
    "mongodb",
    "jobs",
    "nyc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.3.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.5.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  }
}
