# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_jwt_secret_here

# Server Configuration
PORT=8000
NODE_ENV=development

# CORS: comma-separated allowed origins for cross-origin clients (e.g. the
# mobile app) in production. Leave empty for same-origin only.
# In development the server always allows http://localhost:3000.
# Example: CORS_ORIGIN=https://myapp.example.com,https://other.example.com
CORS_ORIGIN=

# NYC Jobs API (NYC Open Data - no key required)
NYC_JOBS_API_URL=https://data.cityofnewyork.us/resource/kpav-sd4t.json

# USAJobs API (register at https://developer.usajobs.gov/APIRequest/Index)
USAJOBS_API_KEY=your_usajobs_api_key
USAJOBS_EMAIL=your_email@example.com
USAJOBS_BASE_URL=https://data.usajobs.gov/api/Search

# Mapbox (client-side, read at client build time — get a free token at
# https://account.mapbox.com/access-tokens/)
REACT_APP_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Note: the Expo mobile app (apps/mobile) reads EXPO_PUBLIC_API_BASE_URL from
# its own config (apps/mobile/eas.json or a .env file there), not from this file.

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000

# Cap on how long any single scraper may run before the refresh gives up on it
# and moves on (default 90 minutes). Columbia honours a 5.5s robots.txt crawl
# delay serially, so a cold start there legitimately takes about an hour.
SCRAPER_TIMEOUT_MS=5400000

# Saved-search alert emails (all optional).
# Without SMTP configured, alerts still work in-app — saved searches show a
# "N new" count — but no email is sent. Set all four SMTP_* values to enable
# delivery. APP_URL is the public site URL used for links inside those emails.
APP_URL=https://nyc-jobs-app.onrender.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=
